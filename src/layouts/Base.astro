---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IncidentBlueprints from '../components/IncidentBlueprints.astro';
import { SITE, type SeriesId } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  series?: SeriesId;
  /** Decorative drawing behind the top of the page. Per-page artwork comes later; 'none' turns it off. */
  background?: 'incidents' | 'none';
}

const { title, description = SITE.description, series, background = 'incidents' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body data-series={series}>
    <Header active={series} />
    <main>
      {
        background !== 'none' && (
          <div class="page-bg">
            <IncidentBlueprints />
          </div>
        )
      }
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main { position: relative; isolation: isolate; }
  .page-bg {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(640px, 100vh);
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent);
    mask-image: linear-gradient(to bottom, #000 65%, transparent);
  }
</style>
