---
interface Props {
  type?: 'note' | 'lesson' | 'try';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const defaults = { note: 'Note', lesson: 'The lesson', try: 'Try it yourself' };
---

<aside class={`callout panel ${type}`}>
  <p class="label"><span class="hot">[ {title ?? defaults[type]} ]</span></p>
  <slot />
</aside>

<style>
  .callout { margin: 2rem 0; padding: 1rem 1.25rem; }
  .callout.note .hot { color: var(--muted); }
  .callout.try { border-color: color-mix(in srgb, var(--accent) 45%, var(--rule)); }
  .label { margin: 0 0 0.5rem; }
  .callout :global(p:last-child) { margin-bottom: 0; }
</style>
