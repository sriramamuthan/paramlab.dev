---
import { SITE, SERIES } from '../data/site';

interface Props {
  active?: string;
}

const path = Astro.url.pathname;
const links = [
  { href: '/lab/', label: SERIES.lab.name, key: 'lab' },
  { href: '/explore/', label: SERIES.explore.name, key: 'explore' },
  { href: '/now/', label: 'Now', key: 'now' },
  { href: '/about/', label: 'About', key: 'about' },
];
const isActive = (key: string, href: string) => Astro.props.active === key || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.title} home`}>
      <svg class="mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" />
        <line x1="7" y1="16" x2="25" y2="16" stroke="currentColor" stroke-width="2" opacity="0.35" />
        <line x1="7" y1="16" x2="18" y2="16" stroke="currentColor" stroke-width="2" />
        <rect class="knob" x="15" y="11" width="6" height="10" fill="var(--lab)" />
      </svg>
      <span class="word">param<span class="lab">lab</span></span>
    </a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} data-key={l.key} aria-current={isActive(l.key, l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <button class="theme" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.site-header .theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    flex-wrap: wrap;
    min-height: 3.75rem;
    padding-block: 0.6rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .word {
    font: 700 1.2rem/1 var(--font-display);
    letter-spacing: -0.03em;
  }
  .word .lab { color: var(--lab); }
  .knob { transition: transform 0.25s ease; }
  .brand:hover .knob { transform: translateX(4px); }
  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem 1.4rem;
    flex-wrap: wrap;
    font: 500 0.74rem var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  nav a {
    position: relative;
    padding-block: 0.3rem;
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -0.65rem;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    background: var(--ink);
  }
  nav a[data-key='lab'][aria-current='page']::before { background: var(--lab); }
  nav a[data-key='explore'][aria-current='page']::before { background: var(--explore); }
  .theme {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .theme:hover { border-color: var(--ink); }
</style>
