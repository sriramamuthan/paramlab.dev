---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="wrap site-footer">
  <p>© {year} {SITE.author}. Code on <a href={SITE.github}>GitHub</a>, MIT licensed.</p>
  <p>
    <a href="/rss.xml">RSS</a>
    {SITE.youtube && <> · <a href={SITE.youtube}>YouTube</a></>}
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 6rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.88rem;
  }
  p { margin: 0; }
</style>
