---
// Click-to-load embed: no YouTube scripts or cookies until the viewer presses play.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<lite-youtube data-id={id} data-title={title}>
  <button type="button" aria-label={`Play video: ${title}`} style={`background-image:url(${thumb})`}>
    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
      <path d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2.3 34 .3 34 .3S12.8.3 7.5 1.7a8.6 8.6 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.6 8.6 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.6 8.6 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z" fill="#f00" />
      <path d="M45 24 27 14v20" fill="#fff" />
    </svg>
  </button>
</lite-youtube>

<script>
  class LiteYouTube extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1&rel=0`;
        iframe.title = this.dataset.title ?? 'YouTube video';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        this.replaceChildren(iframe);
      }, { once: true });
    }
  }
  customElements.define('lite-youtube', LiteYouTube);
</script>

<style>
  lite-youtube {
    display: block;
    aspect-ratio: 16 / 9;
    margin: 2rem 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
  }
  lite-youtube :global(iframe),
  button {
    width: 100%;
    height: 100%;
    border: 0;
  }
  button {
    display: grid;
    place-items: center;
    background: center / cover no-repeat;
    cursor: pointer;
  }
  button svg { opacity: 0.85; transition: opacity 0.15s; }
  button:hover svg { opacity: 1; }
</style>
