---
import { SERIES } from '../data/site';
import { formatDate, seriesOf, urlOf, type Post } from '../data/posts';

interface Props {
  posts: Post[];
  showSeries?: boolean;
}

const { posts, showSeries = false } = Astro.props;
const ref = (post: Post) =>
  post.data.episode !== undefined ? `EP-${String(post.data.episode).padStart(2, '0')}` : '—';
---

<ol class="log">
  {
    posts.map((post) => (
      <li data-series={seriesOf(post)}>
        <a href={urlOf(post)}>
          <span class="ref">{ref(post)}</span>
          <span class="body">
            <span class="title">{post.data.title}</span>
            <span class="desc">{post.data.description}</span>
          </span>
          <span class="meta label">
            {showSeries && <span class="hot">{SERIES[seriesOf(post)].name}</span>}
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {post.data.draft && <span class="hot">Draft</span>}
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .log { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  li { border-bottom: 1px solid var(--rule); }
  a {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    padding: 1.25rem 0;
    text-decoration: none;
  }
  .ref { font: 600 0.85rem var(--font-mono); color: var(--accent); }
  .body { display: grid; gap: 0.3rem; }
  .title { font: 600 1.3rem/1.2 var(--font-display); letter-spacing: -0.015em; }
  a:hover .title { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  .desc { color: var(--muted); max-width: 62ch; }
  .meta { display: grid; gap: 0.3rem; justify-items: end; white-space: nowrap; }
  @media (max-width: 640px) {
    a { grid-template-columns: 1fr; }
    .meta { justify-items: start; grid-auto-flow: column; justify-content: start; gap: 1rem; }
  }
</style>
