---
import { STATUS_LABEL, type RoadmapItem } from '../data/roadmap';

interface Props {
  items: RoadmapItem[];
}

const { items } = Astro.props;
---

<div class="roadmap">
  <table>
    <thead>
      <tr>
        <th scope="col">Ref</th>
        <th scope="col">Subject</th>
        <th scope="col">The one-line version</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        items.map((item) => (
          <tr data-status={item.status}>
            <td class="ref">{item.ref}</td>
            <td class="subject">
              {item.href ? <a href={item.href}>{item.title}</a> : item.title}
              {item.year && <span class="year">{item.year}</span>}
            </td>
            <td class="hook">{item.hook}</td>
            <td>
              <span class="chip">{STATUS_LABEL[item.status]}</span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .roadmap { overflow-x: auto; border: 1px solid var(--rule-strong); background: var(--surface); }
  table { width: 100%; min-width: 36rem; border-collapse: collapse; }
  th {
    font: 500 0.68rem var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    background: var(--panel);
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  td { padding: 0.75rem 0.9rem; border-bottom: 1px solid var(--rule); vertical-align: baseline; }
  tr:last-child td { border-bottom: 0; }
  .ref { font: 600 0.8rem var(--font-mono); color: var(--muted); white-space: nowrap; }
  .subject { font: 600 1rem var(--font-display); white-space: nowrap; }
  .subject a { color: var(--accent); }
  .year { margin-left: 0.6rem; font: 400 0.75rem var(--font-mono); color: var(--muted); }
  .hook { color: var(--muted); font-size: 0.94rem; }
  .chip {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    font: 500 0.66rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid var(--rule);
    color: var(--muted);
  }
  [data-status='published'] .chip { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  [data-status='in-progress'] .chip { border-color: var(--accent); color: var(--accent); }
  [data-status='in-progress'] .chip::before { content: '● '; }
  [data-status='planned'] { opacity: 0.85; }

  /* Phones: one card per row instead of a squeezed table */
  @media (max-width: 640px) {
    table { min-width: 0; }
    thead { display: none; }
    tr {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 0.2rem 0.75rem;
      padding: 0.8rem 0.9rem;
      border-bottom: 1px solid var(--rule);
    }
    tr:last-child { border-bottom: 0; }
    td { padding: 0; border: 0; }
    .ref { grid-row: 1; align-self: center; }
    .subject { grid-column: 2; white-space: normal; }
    td:last-child { grid-column: 3; grid-row: 1; align-self: center; }
    .hook { grid-column: 1 / -1; }
  }
</style>
