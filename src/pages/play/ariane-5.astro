---
// Standalone, shareable version of the Ariane 5 demo. Shared links carry ?v=<slider value>.
import Base from '../../layouts/Base.astro';
import OverflowDemo from '../../components/demos/OverflowDemo.astro';
import Follow from '../../components/Follow.astro';
import { SERIES } from '../../data/site';
---

<Base
  title="Crash Ariane 5 yourself"
  description="Drag one number past 32,767 and recreate the software failure that destroyed Ariane 5 on its first flight."
  series="lab"
>
  <article class="wrap play">
    <p class="label"><span class="hot">Interactive</span> · Ariane 5 · 4 June 1996</p>
    <h1>Crash Ariane 5 yourself.</h1>
    <p class="lede">
      Ariane 5’s guidance software converted a 64-bit value into a 16-bit integer with no range check. Ariane 4 never
      flew fast enough to overflow it. Ariane 5 did, 37 seconds after launch. Find the number.
    </p>
    <OverflowDemo />
    <p class="muted">
      This is a teaser. The full episode rebuilds both guidance computers from the inquiry report.
      <a href="/lab/">See the season →</a>
    </p>
    <Follow repo={SERIES.lab.repo} />
  </article>
</Base>

<style>
  .play { max-width: 46rem; padding-block: 3rem 1rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.6rem 0 1rem; }
  .muted { color: var(--muted); }
</style>
