---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import SignalScope from '../components/SignalScope.astro';
import { SERIES } from '../data/site';
import { getPosts } from '../data/posts';

const posts = (await getPosts()).slice(0, 6);
const counts = {
  lab: (await getPosts('lab')).length,
  explore: (await getPosts('explore')).length,
};
const modules = [
  { ...SERIES.lab, code: 'A', status: counts.lab ? `${counts.lab} ${counts.lab === 1 ? 'episode' : 'episodes'}` : 'In development' },
  { ...SERIES.explore, code: 'B', status: counts.explore ? `${counts.explore} explainers` : 'In development' },
];
---

<Base>
  <section class="wrap hero">
    <div class="copy">
      <p class="label"><span class="hot" style="color: var(--lab)">■</span> paramlab · building in public</p>
      <h1>Change one thing.<br />See what happens.</h1>
      <p class="lede">
        Every system has one parameter that matters more than the rest. Here we find it, push it, and watch what
        breaks. Famous engineering failures you can cause yourself, and science and maths you can poke at until it
        clicks.
      </p>
    </div>
    <SignalScope />
  </section>

  <section class="wrap">
    <div class="section-head"><span class="label">01</span><h2>Modules</h2></div>
    <div class="modules">
      {
        modules.map((m) => (
          <a class="module panel" href={`/${m.id}/`} data-series={m.id}>
            <span class="label row">
              <span>Module {m.code}</span>
              <span class="hot">{m.status}</span>
            </span>
            <span class="name">{m.name}</span>
            <span class="tagline">{m.tagline}</span>
            <span class="desc">{m.description}</span>
            <span class="label go">Open module →</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="wrap latest">
        <div class="section-head"><span class="label">02</span><h2>Latest log entries</h2></div>
        <PostList posts={posts} showSeries />
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 2.5rem 3.5rem;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 6vw, 5rem);
  }
  .hero h1 { font-size: clamp(2.4rem, 5.2vw, 3.7rem); }
  @media (max-width: 880px) {
    .hero { grid-template-columns: 1fr; }
  }
  .modules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
  }
  .module {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.4rem 1.5rem 1.3rem;
    text-decoration: none;
    border-top: 3px solid var(--accent);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .module:hover { border-color: var(--accent); transform: translateY(-2px); }
  .row { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.4rem; }
  .name { font: 600 1.75rem/1.1 var(--font-display); letter-spacing: -0.02em; }
  .tagline { font: 500 0.95rem var(--font-mono); color: var(--accent); }
  .desc { color: var(--muted); }
  .go { margin-top: 0.8rem; color: var(--ink); }
  .module:hover .go { color: var(--accent); }
  .latest { margin-top: 4.5rem; }
</style>
