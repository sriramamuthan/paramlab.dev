// Cloudflare deploy config. The site is fully static: `npm run build` writes dist/, and the Worker only serves those files.
{
  "name": "paramlab-dev",
  "compatibility_date": "2026-06-01",
  // Attached on every deploy; Cloudflare creates the DNS records and certificates.
  "routes": [
    { "pattern": "paramlab.dev", "custom_domain": true },
    { "pattern": "www.paramlab.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
